# 실제 검사 백엔드 전용. 화면 표현 AI 설정과 연결하지 않습니다.
# GUI의 실제 검사 백엔드 탭에서도 .env에 저장할 수 있습니다.
WEBPILOT_BACKEND_PROVIDER=anthropic
WEBPILOT_BACKEND_ANTHROPIC_PLAN_MODEL=claude-opus-5-5
WEBPILOT_BACKEND_ANTHROPIC_TRIAGE_MODEL=claude-sonnet-5-5
WEBPILOT_BACKEND_OPENAI_PLAN_MODEL=gpt-6.2-sol
WEBPILOT_BACKEND_OPENAI_TRIAGE_MODEL=gpt-6-luna
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
