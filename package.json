{
  "name": "webpilot-desktop",
  "private": true,
  "version": "0.4.3",
  "webpilotWorkspace": "webpilot-report-root-v1",
  "description": "WebPilot — 웹 테스트 에이전트를 위한 데스크톱 워크스페이스",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/dev.cjs",
    "build": "tsc -b && vite build",
    "start": "node scripts/start.cjs",
    "test": "tsx --test tests/*.test.ts && node --test scripts/*.test.cjs",
    "test:ui": "playwright test",
    "package": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.5.438",
    "playwright-core": "^1.65.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "studio.webpilot.desktop",
    "productName": "WebPilot",
    "directories": {
      "output": "release/0.4.3"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/app.ico",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "icon": "public/app.ico",
      "signExecutable": false
    }
  }
}
