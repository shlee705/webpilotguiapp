{
  "name": "webpilot-desktop",
  "private": true,
  "version": "1.0.1",
  "webpilotWorkspace": "webpilot-report-root-v1",
  "description": "WebPilot — 웹 테스트 에이전트를 위한 데스크톱 워크스페이스",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/dev.cjs",
    "build": "tsc -b && vite build",
    "start": "node scripts/start.cjs",
    "test": "tsx --test tests/*.test.ts && node --test scripts/*.test.cjs",
    "test:ui": "playwright test",
    "backend:setup": "node scripts/setup-backend.cjs",
    "setup:backend": "node scripts/setup-backend.cjs",
    "backend:check": "node scripts/setup-backend.cjs --check",
    "package": "npm run backend:setup && npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.5.438",
    "playwright-core": "^1.65.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "studio.webpilot.desktop",
    "productName": "WebPilot",
    "directories": {
      "output": "release/1.0.1"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/app.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "webtestpilot-backend",
        "to": "webtestpilot-backend",
        "filter": [
          "package.json",
          "package-lock.json",
          "qa/package.json",
          "qa/package-lock.json",
          "qa/src/**/*",
          "qa/prompts/**/*",
          "qa/node_modules/**/*",
          ".browsers/**/*",
          "!**/.env*",
          "!**/.npmrc",
          "!**/ai-settings.json",
          "!**/auth_state.json",
          "!**/storage_state.json",
          "!**/storageState.json",
          "!**/backend-runs/**/*",
          "!**/.browser-profile/**/*",
          "!.browsers/.links/**/*"
        ]
      },
      {
        "from": "webtestpilot-backend/node_modules",
        "to": "webtestpilot-backend/node_modules",
        "filter": [
          "**/*",
          "!**/.env*",
          "!**/.npmrc",
          "!**/ai-settings.json",
          "!**/auth_state.json",
          "!**/storage_state.json",
          "!**/storageState.json",
          "!**/backend-runs/**/*",
          "!**/.browser-profile/**/*"
        ]
      },
      {
        "from": "artifacts/backend-runtime",
        "to": "backend-runtime",
        "filter": [
          "node.exe"
        ]
      }
    ],
    "win": {
      "target": "dir",
      "icon": "public/app.ico",
      "signExecutable": false
    }
  }
}
